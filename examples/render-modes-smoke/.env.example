# Copy to `.env` for local secrets and overrides.
# Precedence: config/*.toml < .env < process environment.

APP_ENV=development
APP_ADDR=127.0.0.1:3000
APP_URL=http://127.0.0.1:3000

TRUSTED_PROXIES=none
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
VITE_DEV_URL=http://127.0.0.1:5173
PHOENIX_LOG=info,hyper=warn

# Database overrides for the driver selected during `px new`.
# DB_PASSWORD=secret
# DATABASE_URL=sqlite:storage/app.sqlite
